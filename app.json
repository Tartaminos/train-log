{
  "expo": {
    "name": "train-log",
    "slug": "train-log",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.example.trainlog"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "scheme": "train-log",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
