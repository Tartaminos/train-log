{
  "expo": {
    "name": "train-log",
    "slug": "train-log",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "androidNavigationBar": {
      "visible": "immersive",
      "barStyle": "light-content",
      "backgroundColor": "#0F1115"
    },
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#0F1115"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.example.trainlog"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "scheme": "train-log",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "42bbd2b0-efa2-4430-bc29-6166bfba7b46"
      }
    },
    "owner": "johannsimon"
  }
}
